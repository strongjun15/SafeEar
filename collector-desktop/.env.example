# SafeEar 서버 설정 (docs/AUTH_SETUP.md 참고)
# 이 파일을 .env 로 복사하고 값을 채운 뒤 다시 빌드하세요. .env는 git에 올라가지 않아요.
# 두 값이 비어 있으면 로그인 없이 이 PC 안에서만 동작합니다.

# Supabase 프로젝트 → Project Settings → API (또는 Data API)
SAFEEAR_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# anon (public) 키 또는 publishable 키. 공개돼도 되는 키예요 (서버의 행 단위 접근 규칙이 데이터를 지켜요).
# service_role / secret 키는 절대 넣지 마세요.
SAFEEAR_SUPABASE_ANON_KEY=

# 구글 로그인이 돌아올 로컬 포트. Supabase Redirect URLs에 http://127.0.0.1:51789/** 를 넣어야 해요.
SAFEEAR_AUTH_PORT=51789
